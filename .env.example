# Copy to .env and fill in. .env is git-ignored; never commit it.

# --- Required -----------------------------------------------------------

# Hetzner Cloud API token (Console > project > Security > API tokens, Read & Write).
HCLOUD_TOKEN=

# Cloudflare API token. Permissions are listed in the README.
CLOUDFLARE_API_TOKEN=

# Public address of the blog. Its domain must be a zone in your Cloudflare account.
BLOG_HOSTNAME=blog.example.com

# The only email address allowed to open the SSH tunnel (Cloudflare Access).
ACCESS_EMAIL=you@example.com

# --- Optional (defaults shown) -------------------------------------------

# PROJECT_NAME=ghost-blog          # names the server, firewall, tunnel, SSH key
# SERVER_TYPE=cx23
# SERVER_LOCATION=nbg1
# SERVER_IMAGE=ubuntu-24.04
# ADMIN_USER=deploy
# GHOST_IMAGE=ghost:6-alpine
# CLOUDFLARED_IMAGE=cloudflare/cloudflared:latest
# CLOUDFLARE_ZONE=example.com      # default: last two labels of BLOG_HOSTNAME
# SSH_HOSTNAME=ssh-ghost-blog.example.com
# SSH_KEY_FILE=~/.ssh/ghost-blog_ed25519   # created if it does not exist
